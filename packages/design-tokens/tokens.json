{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Nhoga design tokens. Single source of truth consumed by apps/web (via tokens.css) and apps/mobile (via a generated TS theme). Never hardcode a colour, size, or radius outside this file.",
  "$version": "1.0.0-phase1",

  "color": {
    "$description": "Primitive palette. Do not reference primitives directly in components — use the semantic layer below.",

    "primary": {
      "$description": "Verde Nhoga. Brand, trust, primary actions. See DECISIONS.md D-07.",
      "50":  { "$value": "#EFF9F4" },
      "100": { "$value": "#D6F0E4" },
      "200": { "$value": "#A8DEC7" },
      "300": { "$value": "#6AC4A1" },
      "400": { "$value": "#2BA378" },
      "500": { "$value": "#12855C" },
      "600": { "$value": "#0E6B4A" },
      "700": { "$value": "#0A5539", "$description": "Brand anchor. 9.1:1 on white." },
      "800": { "$value": "#08422F" },
      "900": { "$value": "#052E22" }
    },

    "accent": {
      "$description": "Âmbar. Reserved for commerce moments: buy-now, price emphasis, sale badges, rating stars. Never for navigation or generic emphasis — the scarcity is what makes it mean 'this spends money'.",
      "50":  { "$value": "#FFF7EB" },
      "100": { "$value": "#FFECCC" },
      "200": { "$value": "#FFD894" },
      "300": { "$value": "#FFB340" },
      "400": { "$value": "#F59300" },
      "500": { "$value": "#E07A00" },
      "600": { "$value": "#B35F00", "$description": "Minimum shade that carries white text at 4.6:1. Use this for filled amber buttons, never 400/500." },
      "700": { "$value": "#8A4B00" }
    },

    "neutral": {
      "$description": "Warm-tinted greys. Warm rather than blue-grey so the green primary does not read as cold.",
      "0":   { "$value": "#FFFFFF" },
      "25":  { "$value": "#FCFCFB" },
      "50":  { "$value": "#F7F7F5" },
      "100": { "$value": "#EFEFEC" },
      "200": { "$value": "#E2E2DE" },
      "300": { "$value": "#C9C9C3" },
      "400": { "$value": "#A3A39C" },
      "500": { "$value": "#6E6E66", "$description": "Lightest grey permitted for body text. 5.1:1 on white." },
      "600": { "$value": "#57574F" },
      "700": { "$value": "#3F3F39" },
      "800": { "$value": "#2A2A26" },
      "900": { "$value": "#1A1A17" }
    },

    "success": {
      "50":  { "$value": "#ECFDF3" },
      "100": { "$value": "#D1FADF" },
      "500": { "$value": "#12B76A" },
      "600": { "$value": "#039855" },
      "700": { "$value": "#027A48" }
    },
    "warning": {
      "50":  { "$value": "#FFFAEB" },
      "100": { "$value": "#FEF0C7" },
      "500": { "$value": "#F79009" },
      "600": { "$value": "#DC6803" },
      "700": { "$value": "#B54708" }
    },
    "danger": {
      "50":  { "$value": "#FEF3F2" },
      "100": { "$value": "#FEE4E2" },
      "500": { "$value": "#D92D20" },
      "600": { "$value": "#B42318", "$description": "6.6:1 on white. Use for destructive text and filled destructive buttons." },
      "700": { "$value": "#912018" }
    },
    "info": {
      "50":  { "$value": "#EFF8FF" },
      "100": { "$value": "#D1E9FF" },
      "500": { "$value": "#2E90FA" },
      "600": { "$value": "#175CD3" },
      "700": { "$value": "#1849A9" }
    }
  },

  "semantic": {
    "$description": "What components actually reference. Each has a light and dark value.",
    "light": {
      "bg-page":            { "$value": "{color.neutral.50}" },
      "bg-surface":         { "$value": "{color.neutral.0}" },
      "bg-surface-sunken":  { "$value": "{color.neutral.100}" },
      "bg-inverse":         { "$value": "{color.neutral.900}" },
      "text-primary":       { "$value": "{color.neutral.900}" },
      "text-secondary":     { "$value": "{color.neutral.600}" },
      "text-tertiary":      { "$value": "{color.neutral.500}" },
      "text-on-brand":      { "$value": "{color.neutral.0}" },
      "text-price":         { "$value": "{color.neutral.900}" },
      "text-price-sale":    { "$value": "{color.danger.600}" },
      "text-link":          { "$value": "{color.primary.700}" },
      "border-subtle":      { "$value": "{color.neutral.200}" },
      "border-default":     { "$value": "{color.neutral.300}" },
      "border-strong":      { "$value": "{color.neutral.400}" },
      "border-focus":       { "$value": "{color.primary.500}" },
      "action-primary":     { "$value": "{color.primary.700}" },
      "action-primary-hover": { "$value": "{color.primary.800}" },
      "action-buy":         { "$value": "{color.accent.600}" },
      "action-buy-hover":   { "$value": "{color.accent.700}" },
      "action-destructive": { "$value": "{color.danger.600}" },
      "rating-star":        { "$value": "{color.accent.400}" },
      "badge-verified":     { "$value": "{color.primary.600}" },
      "badge-sale":         { "$value": "{color.accent.600}" },
      "skeleton-base":      { "$value": "{color.neutral.100}" },
      "skeleton-shine":     { "$value": "{color.neutral.200}" },
      "offline-banner":     { "$value": "{color.neutral.800}" }
    },
    "dark": {
      "$description": "Dark mode matters more here than in most markets: OLED entry-level Androids are common and dark UI measurably extends battery on a phone the user may not be able to charge conveniently.",
      "bg-page":            { "$value": "#121210" },
      "bg-surface":         { "$value": "#1C1C19" },
      "bg-surface-sunken":  { "$value": "#0C0C0B" },
      "bg-inverse":         { "$value": "{color.neutral.50}" },
      "text-primary":       { "$value": "#F2F2EF" },
      "text-secondary":     { "$value": "#B8B8B0" },
      "text-tertiary":      { "$value": "#93938B" },
      "text-on-brand":      { "$value": "{color.neutral.0}" },
      "text-price":         { "$value": "#F2F2EF" },
      "text-price-sale":    { "$value": "#FF7A6B" },
      "text-link":          { "$value": "{color.primary.300}" },
      "border-subtle":      { "$value": "#2E2E29" },
      "border-default":     { "$value": "#3F3F39" },
      "border-strong":      { "$value": "#57574F" },
      "border-focus":       { "$value": "{color.primary.400}" },
      "action-primary":     { "$value": "{color.primary.500}" },
      "action-primary-hover": { "$value": "{color.primary.400}" },
      "action-buy":         { "$value": "{color.accent.400}" },
      "action-buy-hover":   { "$value": "{color.accent.300}" },
      "action-destructive": { "$value": "{color.danger.500}" },
      "rating-star":        { "$value": "{color.accent.300}" },
      "badge-verified":     { "$value": "{color.primary.400}" },
      "badge-sale":         { "$value": "{color.accent.400}" },
      "skeleton-base":      { "$value": "#262622" },
      "skeleton-shine":     { "$value": "#33332E" },
      "offline-banner":     { "$value": "#33332E" }
    }
  },

  "font": {
    "family": {
      "sans-web":    { "$value": "'Inter var', Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
      "sans-mobile": { "$value": "System", "$description": "Mobile uses the platform font (Roboto / SF) — zero font bytes over the network. See DECISIONS.md D-09." },
      "mono":        { "$value": "ui-monospace, 'SF Mono', 'Roboto Mono', monospace", "$description": "Order references, tracking codes, NUIT." }
    },
    "size": {
      "$description": "Base 16px, ~1.2 ratio. 14px is the floor for any text the user must read; 12px is permitted only for non-essential metadata.",
      "2xs": { "$value": "11px" },
      "xs":  { "$value": "12px" },
      "sm":  { "$value": "14px" },
      "md":  { "$value": "16px" },
      "lg":  { "$value": "18px" },
      "xl":  { "$value": "20px" },
      "2xl": { "$value": "24px" },
      "3xl": { "$value": "30px" },
      "4xl": { "$value": "36px" }
    },
    "weight": {
      "regular":  { "$value": "400" },
      "medium":   { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold":     { "$value": "700" }
    },
    "lineHeight": {
      "tight":   { "$value": "1.2" },
      "snug":    { "$value": "1.35" },
      "normal":  { "$value": "1.5" },
      "relaxed": { "$value": "1.65", "$description": "Body copy. Portuguese runs 15-25% longer than English (D-01); generous leading keeps wrapped lines readable." }
    },
    "letterSpacing": {
      "tight":  { "$value": "-0.02em" },
      "normal": { "$value": "0" },
      "wide":   { "$value": "0.04em" }
    }
  },

  "space": {
    "$description": "4px base grid.",
    "0":  { "$value": "0px" },
    "1":  { "$value": "2px" },
    "2":  { "$value": "4px" },
    "3":  { "$value": "8px" },
    "4":  { "$value": "12px" },
    "5":  { "$value": "16px" },
    "6":  { "$value": "20px" },
    "7":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "9":  { "$value": "40px" },
    "10": { "$value": "48px" },
    "11": { "$value": "64px" },
    "gutter-mobile": { "$value": "16px" },
    "gutter-tablet": { "$value": "24px" },
    "gutter-desktop":{ "$value": "32px" }
  },

  "radius": {
    "none": { "$value": "0px" },
    "sm":   { "$value": "6px" },
    "md":   { "$value": "10px" },
    "lg":   { "$value": "14px" },
    "xl":   { "$value": "20px" },
    "full": { "$value": "9999px" }
  },

  "elevation": {
    "$description": "Borders carry most separation (D-08). Shadows are permitted only on overlays that float above the page.",
    "none":   { "$value": "none" },
    "sticky": { "$value": "0 -1px 0 0 rgba(26,26,23,0.08), 0 -4px 12px -4px rgba(26,26,23,0.06)" },
    "overlay":{ "$value": "0 8px 24px -6px rgba(26,26,23,0.16), 0 2px 6px -2px rgba(26,26,23,0.08)" },
    "modal":  { "$value": "0 24px 48px -12px rgba(26,26,23,0.24)" }
  },

  "size": {
    "touch-min":      { "$value": "48px", "$description": "Hard minimum for any interactive target. Non-negotiable — see 03-design-system.md §7." },
    "touch-spacing":  { "$value": "8px" },
    "icon-sm":        { "$value": "16px" },
    "icon-md":        { "$value": "20px" },
    "icon-lg":        { "$value": "24px" },
    "control-sm":     { "$value": "36px" },
    "control-md":     { "$value": "48px" },
    "control-lg":     { "$value": "56px" },
    "bottom-nav":     { "$value": "60px" },
    "header-mobile":  { "$value": "56px" },
    "header-desktop": { "$value": "72px" }
  },

  "breakpoint": {
    "$description": "Base is 360px — the low-end Android reference device (D-03), not a 390px iPhone.",
    "base": { "$value": "360px" },
    "sm":   { "$value": "480px" },
    "md":   { "$value": "768px" },
    "lg":   { "$value": "1024px" },
    "xl":   { "$value": "1280px" },
    "2xl":  { "$value": "1440px" }
  },

  "motion": {
    "$description": "Short and cheap. Long or physics-based animation is a frame-rate cost on entry-level hardware. All of it must be disabled under prefers-reduced-motion.",
    "duration": {
      "instant": { "$value": "80ms" },
      "fast":    { "$value": "120ms" },
      "normal":  { "$value": "200ms" },
      "slow":    { "$value": "300ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "enter":    { "$value": "cubic-bezier(0, 0, 0, 1)" },
      "exit":     { "$value": "cubic-bezier(0.3, 0, 1, 1)" }
    }
  },

  "z": {
    "base":        { "$value": "0" },
    "sticky":      { "$value": "100" },
    "bottomNav":   { "$value": "200" },
    "header":      { "$value": "300" },
    "overlay":     { "$value": "400" },
    "modal":       { "$value": "500" },
    "toast":       { "$value": "600" },
    "offlineBanner": { "$value": "700", "$description": "Above everything. Connectivity status must never be occluded." }
  },

  "media": {
    "$description": "Enforced byte budgets, not guidelines — CI fails a build that exceeds them. See DECISIONS.md D-09.",
    "budget": {
      "grid-thumb":   { "$value": "20KB",  "$description": "320x320 AVIF, WebP fallback" },
      "list-thumb":   { "$value": "12KB",  "$description": "160x160" },
      "pdp-hero":     { "$value": "80KB",  "$description": "1080w, progressive" },
      "pdp-gallery":  { "$value": "60KB",  "$description": "per additional image, lazy" },
      "vendor-banner":{ "$value": "60KB" },
      "first-screen-total": { "$value": "500KB", "$description": "Total transfer for first meaningful paint of Home" }
    },
    "placeholder": { "$value": "lqip", "$description": "Inline base64 LQIP under 400 bytes, rendered instantly, replaced on load." }
  }
}
