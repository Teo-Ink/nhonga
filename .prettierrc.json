{
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "printWidth": 100,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": ["*.md"], "options": { "proseWrap": "preserve" } },
    { "files": ["*.yml", "*.yaml"], "options": { "singleQuote": false } }
  ]
}
