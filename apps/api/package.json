{
  "name": "@nhonga/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nhonga API — modular monolith. Phase 3a/3b deliver the payments layer, schema, checkout, and reconciliation; the HTTP layer follows in 3c.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "db:generate": "tsc -p tsconfig.json && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/seed.sql"
  },
  "dependencies": {
    "@nestjs/common": "^12",
    "@nestjs/config": "^12",
    "@nestjs/core": "^12",
    "@nestjs/platform-express": "^12",
    "@nhonga/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "helmet": "^8.3.0",
    "postgres": "3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "20.16.11",
    "drizzle-kit": "0.31.10",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
