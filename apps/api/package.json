{
  "name": "@nhoga/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nhoga API — modular monolith. Phase 3a/3b deliver the payments layer, schema, checkout, and reconciliation; the HTTP layer follows in 3c.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "db:generate": "tsc -p tsconfig.json && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nhoga/shared": "workspace:*",
    "drizzle-orm": "0.36.4",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "drizzle-kit": "0.28.1",
    "typescript": "5.6.3",
    "vitest": "2.1.2"
  }
}
