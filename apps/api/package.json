{
  "name": "@nhonga/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nhonga API — modular monolith. Phase 3a/3b deliver the payments layer, schema, checkout, and reconciliation; the HTTP layer follows in 3c.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "db:generate": "tsc -p tsconfig.json && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/seed.sql",
    "openapi:write": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm build && node scripts/write-openapi.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nhonga/shared": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/node": "11.16.0",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "helmet": "^8.3.0",
    "postgres": "3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "20.19.43",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
