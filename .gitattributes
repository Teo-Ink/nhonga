# Normalise line endings. The repository stores LF; deployment targets are Linux
# (ECS on af-south-1) and contributors may be on Windows or macOS. Without this,
# every Windows checkout produces a whole-file diff on first save.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or they will not run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never diff or line-ending-convert these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.keystore binary
*.jks      binary

# Generated. Collapse in diffs and exclude from language statistics; never
# hand-resolve a lockfile conflict — regenerate it with `pnpm install` instead.
pnpm-lock.yaml -diff linguist-generated=true
