{
  "name": "nhonga-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-vendor marketplace for Mozambique",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "api:lint": "redocly lint apps/api/openapi.yaml",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@redocly/cli": "1.25.3",
    "@types/node": "20.16.11",
    "dependency-cruiser": "16.10.4",
    "eslint": "^9.14.0",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3",
    "turbo": "2.1.3",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "2.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
