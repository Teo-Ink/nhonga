# Nhoga — example environment.
# Copy to .env for local development. NEVER put real credentials in this file.
# Production values live in AWS Secrets Manager and are injected into the ECS task
# definition — see docs/phase-2-architecture/05-security-architecture.md §6.

# ── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3001

# ── Datastores ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nhoga:nhoga@localhost:5432/nhoga
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200

# ── Auth ────────────────────────────────────────────────────────────────
# Generate locally: openssl genrsa -out jwt.pem 2048
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── Payments ────────────────────────────────────────────────────────────
# mock  = MockWalletProvider, no external calls, no merchant agreement needed
# live  = real providers. Requires signed agreements with Vodacom / Movitel.
#         See OPEN_QUESTIONS.md OQ-7 and OQ-8.
PAYMENTS_MODE=mock

# Mock tuning. Set MOCK_PAYMENT_SEED for deterministic CI runs.
MOCK_PAYMENT_MIN_DELAY_MS=5000
MOCK_PAYMENT_MAX_DELAY_MS=90000
MOCK_PAYMENT_SEED=
MOCK_CALLBACK_SECRET=dev-only-not-a-real-secret

# Real provider credentials — leave EMPTY. Populated from Secrets Manager in
# staging and production only. Listed here so the shape is documented.
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_INITIATOR_IDENTIFIER=
MPESA_SECURITY_CREDENTIAL=
MPESA_CALLBACK_SECRET=

EMOLA_CLIENT_ID=
EMOLA_CLIENT_SECRET=
EMOLA_MERCHANT_ID=
EMOLA_CALLBACK_SECRET=

# ── Payment behaviour ───────────────────────────────────────────────────
PAYMENT_APPROVAL_TIMEOUT_SECONDS=180
PAYMENT_LATE_SWEEP_HOURS=72

# ── Commission (OQ-4 / D-17) — seed values, overridden by admin config ──
DEFAULT_COMMISSION_BPS=800
DEFAULT_FIXED_FEE_CENTS=1000

# ── SMS (OQ-12) ─────────────────────────────────────────────────────────
SMS_MODE=mock
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=Nhoga
SMS_DAILY_SPEND_CAP_USD=50

# ── Storage ─────────────────────────────────────────────────────────────
S3_BUCKET_MEDIA=nhoga-media-local
S3_BUCKET_KYC=nhoga-kyc-local
AWS_REGION=af-south-1

# ── Observability ───────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
